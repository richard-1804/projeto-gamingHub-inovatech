generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}


model categories {
  id_categories_pk Int     @id @default(autoincrement())
  name             String  @unique(map: "name") @db.VarChar(50)
  description      String? @db.Text
  games            games[]
}

model users {
  id_users_pk Int       @id @default(autoincrement())
  name        String    @db.VarChar(100)
  email       String    @unique(map: "email") @db.VarChar(150)
  password    String    @db.VarChar(255)
  created_at  DateTime? @default(now()) @db.DateTime(0)
  reviews     reviews[]
}

model games {
  id_games_pk      Int        @id @default(autoincrement())
  title            String     @db.VarChar(150)
  description      String     @db.Text
  release_year     Int
  categories_id_fk Int
  created_at       DateTime?  @default(now()) @db.DateTime(0)
  categories       categories @relation(fields: [categories_id_fk], references: [id_categories_pk], onUpdate: Restrict, map: "games_ibfk_1")
  reviews          reviews[]

  @@index([categories_id_fk], map: "categories_id_fk")
}

model reviews {
  id_reviews_pk Int       @id @default(autoincrement())
  rating        Int
  comment       String    @db.Text
  users_id_fk   Int
  games_id_fk   Int
  created_at    DateTime? @default(now()) @db.DateTime(0)
  users         users     @relation(fields: [users_id_fk], references: [id_users_pk], onUpdate: Restrict, map: "reviews_ibfk_1")
  games         games     @relation(fields: [games_id_fk], references: [id_games_pk], onDelete: Cascade, onUpdate: Restrict, map: "reviews_ibfk_2")

  @@index([games_id_fk], map: "games_id_fk")
  @@index([users_id_fk], map: "users_id_fk")
}
